---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Folk Files"
  description="Stories from the Alvean Federation, an urban fantasy collection by AJ Reid."
>
  <main id="main-content">
    <section class="foundation" aria-labelledby="site-title">
      <div class="foundation__index" aria-hidden="true">ALV–6195</div>

      <div class="foundation__copy">
        <p class="kicker">Stories from the Alvean Federation</p>
        <h1 id="site-title">Folk<br />Files</h1>
        <p class="deck">
          Urban fantasy about ordinary people, dangerous Folk, unreliable laws,
          and lives that continue beyond classification.
        </p>
        <p class="status">
          <span aria-hidden="true"></span>
          Public archive initialization in progress
        </p>
      </div>

      <aside class="act-card" aria-label="Protected Travel and Mutual Defense Act">
        <div class="act-card__topline">
          <span>Protected Travel and Mutual Defense Act</span>
          <span>6195</span>
        </div>
        <p class="act-card__section">§ —</p>
        <h2>Provision pending classification</h2>
        <p>
          The public archive is being assembled. Authorized story files and
          related provisions will appear here when disclosure is approved.
        </p>
        <small>Federal Alvean standard</small>
      </aside>
    </section>
  </main>
</SiteLayout>
